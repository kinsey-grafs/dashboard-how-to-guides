      "id": 20,
      "title": "Service Availability Table",
      "type": "row"
    },
    {
      "description": "**Technique: Field Overrides — Dual Column Styling**\n\nThis table applies two independent configurations to the same underlying data using **field overrides** (matched by column name). The **Availability** column uses *threshold-based cell background coloring* — the background shifts automatically from red → yellow → green as values cross defined thresholds (<99%, <99.8%, ≥99.8%). The **Status** column uses *range value mappings* to translate the same raw numbers into human-readable text labels with custom colors. This demonstrates that a single data value can be presented simultaneously as a metric *and* a categorical status label — without duplicating data or queries.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 10,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "### One value, two presentations\n- **Availability** → thresholds color the cell\n- **Status** → value mappings turn the number into a word\n- Same data, no duplicate queries\n\n",
        "mode": "markdown"
      },
      "pluginVersion": "13.3.0-36978054224",
      "targets": [],
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "${DS_TESTDATA}"
      },
      "description": "Real-time availability % per service. Color shows health against SLO thresholds.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Availability"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": 0
                    },
                    {
                      "color": "orange",
                      "value": 99
                    },
                    {
                      "color": "blue",
                      "value": 99.8
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "from": 0,
                      "result": {
                        "color": "red",
                        "index": 0,
                        "text": "Critical"
                      },
                      "to": 99
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 99,
                      "result": {
                        "color": "orange",
                        "index": 1,
                        "text": "Warning"
                      },
                      "to": 99.8
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 99.8,
                      "result": {
                        "color": "blue",
                        "index": 2,
                        "text": "BAU"
                      },
                      "to": 100
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "match": "empty",
                      "result": {
                        "color": "#888888",
                        "index": 3,
                        "text": "No Data"
                      }
                    },
                    "type": "special"
                  },
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#888888",
                        "index": 4,
                        "text": "No Data"
                      }
                    },
                    "type": "special"
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "oneClick": false,
                    "targetBlank": false,
                    "title": "View service logs →",
