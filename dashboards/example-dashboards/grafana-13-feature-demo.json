      "id": 1,
      "options": {
        "annotations": {
          "clustering": -1,
          "multiLane": false
        },
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "enableFacetedFilter": false,
          "overflow": "ellipsis",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Name",
          "sortDesc": false
